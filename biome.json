{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!fixtures",
      "!docs",
      "!apps/desktop/src-tauri/target",
      "!**/*.md",
      "!**/*.tsbuildinfo"
    ]
  }
}
