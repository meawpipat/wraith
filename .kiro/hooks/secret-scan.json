{
  "version": "v1",
  "hooks": [
    {
      "name": "secret-scan",
      "trigger": "PreToolUse",
      "matcher": "^(fs_write|fsWrite|fs_append|fsAppend|str_replace|strReplace|execute_bash|executeBash)$",
      "action": {
        "type": "command",
        "command": "node --experimental-strip-types tools/secret-scan.ts --hook-stdin"
      }
    }
  ]
}
