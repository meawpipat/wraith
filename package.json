{
  "name": "wraith",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "check:platform": "node --experimental-strip-types tools/check-platform.ts",
    "check:secrets": "node --experimental-strip-types tools/secret-scan.ts --tree",
    "check:pins": "node --experimental-strip-types tools/check-workflow-pins.ts",
    "check:suites": "node --experimental-strip-types tools/check-suites-ran.ts",
    "check:si": "node --experimental-strip-types tools/check-si.ts",
    "check:spikes": "node --experimental-strip-types tools/check-spike-results.ts",
    "test:reports": "node --experimental-strip-types tools/clean-reports.ts && pnpm -r test -- --reporter=default --reporter=$PWD/tools/vitest-project-reporter.ts",
    "verify:local": "pnpm lint && pnpm typecheck && pnpm -r --if-present check && pnpm -r build && pnpm test:reports && pnpm check:platform && pnpm check:secrets && pnpm check:pins && pnpm check:suites && pnpm check:spikes && pnpm check:si"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
