{
  "name": "@wraith/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas and message catalogue; the only place schemas are declared (§6.1, §6.2, §6.9).",
  "exports": {
    ".": {
      "@wraith/source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "@wraith/source": "./src/testing/builders.ts",
      "types": "./dist/src/testing/builders.d.ts",
      "default": "./dist/src/testing/builders.js"
    },
    "./testing/arbitraries": {
      "@wraith/source": "./src/testing/arbitraries.ts",
      "types": "./dist/src/testing/arbitraries.d.ts",
      "default": "./dist/src/testing/arbitraries.js"
    }
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/check-boundaries.ts && tsc -p tsconfig.json",
    "test": "vitest run",
    "codegen": "node --experimental-strip-types scripts/codegen.ts",
    "check": "node --experimental-strip-types scripts/check-boundaries.ts && tsc -p tsconfig.scripts.json --noEmit"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "fast-check": "4.10.2"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  }
}
