{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "customConditions": ["@wraith/source"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2022"],
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "scripts",
    "test",
    "vitest.config.ts",
    "../../fixtures/crypto/known-answers.json"
  ]
}
